{
	"name": "Felsstudio",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"remoteUser": "pwuser",
	"updateRemoteUserUID": false,
	"runArgs": ["--hostname=felsstudio", "--add-host=felsstudio:127.0.0.1"],
	"postCreateCommand": "sudo chown -R pwuser:pwuser node_modules && for attempt in 1 2 3; do npm ci && exit 0; [ \"$attempt\" -eq 3 ] && exit 1; sleep 10; done",
	"features": {
		"ghcr.io/coder/devcontainer-features/code-server:2": {
			"version": "4.121.0",
			"host": "0.0.0.0",
			"port": "8080",
			"auth": "password",
			"workspace": "/workspaces/Felsstudio",
			"disableTelemetry": true,
			"disableUpdateCheck": true,
			"extensions": "svelte.svelte-vscode,dbaeumer.vscode-eslint,esbenp.prettier-vscode"
		}
	},
	"mounts": ["source=felsstudio-node_modules,target=/workspaces/Felsstudio/node_modules,type=volume"],
	"appPort": ["127.0.0.1:8081:8080"],
	"forwardPorts": [8080, 5173],
	"portsAttributes": {
		"8080": {
			"label": "code-server",
			"onAutoForward": "openBrowser"
		},
		"5173": {
			"label": "Vite development server",
			"onAutoForward": "openBrowser"
		}
	}
}
