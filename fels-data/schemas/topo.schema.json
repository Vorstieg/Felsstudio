{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://schemas.vorstieg.com/fels-data/topo.schema.json",
	"title": "Fels topo document",
	"description": "Route metadata and optional 2D/3D topo geometry.",
	"type": "object",
	"required": ["routes"],
	"properties": {
		"id": { "type": "string" },
		"name": { "type": "string" },
		"crag_id": { "type": "string" },
		"sector_id": { "type": "string" },
		"description": { "type": "string" },
		"rock": { "type": "string" },
		"tags": { "type": "array", "items": { "type": "string" } },
		"editorMode": { "enum": ["2d", "3d"] },
		"image2D": { "type": ["string", "null"] },
		"imageAspectRatio": { "type": "number", "exclusiveMinimum": 0 },
		"date": { "type": "string" },
		"updated": { "type": "string" },
		"author": { "type": "string" },
		"coordinates": {
			"type": "array",
			"items": { "type": "number" },
			"minItems": 2,
			"maxItems": 3
		},
		"altitude": { "type": "number" },
		"routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
		"paths": { "$ref": "#/$defs/pathCollection" },
		"fixPoints": { "type": "array", "items": { "$ref": "#/$defs/fixPoint" } },
		"outlines": { "type": "array", "items": { "$ref": "#/$defs/outline" } },
		"textLabels": { "type": "array", "items": { "$ref": "#/$defs/textLabel" } }
	},
	"additionalProperties": true,
	"$defs": {
		"point2D": {
			"type": "array",
			"items": { "type": "number", "minimum": 0, "maximum": 1 },
			"minItems": 2,
			"maxItems": 2
		},
		"path2D": { "type": "array", "items": { "$ref": "#/$defs/point2D" }, "minItems": 2 },
		"pathCollection": {
			"type": "object",
			"required": ["type", "features"],
			"properties": {
				"type": { "const": "FeatureCollection" },
				"features": { "type": "array", "items": { "$ref": "#/$defs/pathFeature" } }
			},
			"additionalProperties": true
		},
		"pathFeature": {
			"type": "object",
			"required": ["type", "geometry"],
			"properties": {
				"type": { "const": "Feature" },
				"id": { "type": ["string", "number"] },
				"properties": { "type": "object" },
				"geometry": {
					"type": "object",
					"required": ["type", "coordinates"],
					"properties": {
						"type": { "const": "LineString" },
						"coordinates": {
							"type": "array",
							"minItems": 2,
							"items": { "type": "array", "minItems": 2, "items": { "type": "number" } }
						}
					},
					"additionalProperties": true
				}
			},
			"additionalProperties": true
		},
		"pathRef": {
			"type": "object",
			"required": ["pathId"],
			"properties": {
				"pathId": { "type": ["string", "number"] },
				"role": { "type": "string" },
				"label": { "type": "string" }
			},
			"additionalProperties": true
		},
		"route": {
			"type": "object",
			"required": ["id"],
			"properties": {
				"id": { "type": ["string", "number"] },
				"name": { "type": "string" },
				"type": { "type": "string" },
				"_gradeScale": { "type": "string" },
				"grade": { "type": ["string", "number", "null"] },
				"description": { "type": "string" },
				"tags": { "type": "array", "items": { "type": "string" } },
				"points": {
					"type": "array",
					"items": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
				},
				"orientation": {
					"type": "array",
					"items": { "type": "number" },
					"minItems": 3,
					"maxItems": 3
				},
				"boltAmount": { "type": "number", "minimum": 0 },
				"length": { "type": "number", "minimum": 0 },
				"lineStyle": { "type": "string" },
				"points2D": { "$ref": "#/$defs/path2D" },
				"pitches": { "type": "array", "items": { "$ref": "#/$defs/pitch" } },
				"variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } },
				"fixPoints": { "type": "array", "items": { "type": ["string", "number"] } },
				"assets": { "type": "object" },
				"pathRefs": { "type": "array", "items": { "$ref": "#/$defs/pathRef" } }
			},
			"additionalProperties": true
		},
		"pitch": {
			"type": "object",
			"required": ["id", "type", "pitchNumber", "points2D"],
			"properties": {
				"id": { "type": ["string", "number"] },
				"type": { "const": "pitch" },
				"pitchNumber": { "type": "integer", "minimum": 1 },
				"grade": { "type": ["string", "number", "null"] },
				"lineStyle": { "type": "string" },
				"points2D": { "$ref": "#/$defs/path2D" }
			},
			"additionalProperties": true
		},
		"variant": {
			"type": "object",
			"required": ["id", "points2D"],
			"properties": {
				"id": { "type": ["string", "number"] },
				"points2D": { "$ref": "#/$defs/path2D" },
				"lineStyle": { "type": "string" }
			},
			"additionalProperties": true
		},
		"fixPoint": {
			"type": "object",
			"required": ["id", "type"],
			"properties": {
				"id": { "type": ["string", "number"] },
				"type": { "type": "string" },
				"position2D": { "$ref": "#/$defs/point2D" },
				"position": { "type": "array", "items": { "type": "number" } },
				"rotation2D": { "type": "number" },
				"scale2D": { "type": "number" }
			},
			"additionalProperties": true
		},
		"outline": {
			"type": "object",
			"required": ["id", "points2D"],
			"properties": {
				"id": { "type": ["string", "number"] },
				"lineStyle": { "enum": ["rock", "approach", "descent", "variant", "fixedRope"] },
				"points2D": { "$ref": "#/$defs/path2D" }
			},
			"additionalProperties": true
		},
		"textLabel": {
			"type": "object",
			"required": ["id", "text", "position2D"],
			"properties": {
				"id": { "type": ["string", "number"] },
				"text": { "type": "string" },
				"position2D": { "$ref": "#/$defs/point2D" },
				"fontSize2D": { "type": "number" },
				"color": { "type": "string" },
				"fontWeight": { "type": ["string", "number"] },
				"textAlign2D": { "enum": ["left", "center", "right"] }
			},
			"additionalProperties": true
		}
	}
}
