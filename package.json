{
	"name": "felsstudio",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:outline": "vitest run tests/test-outline-geometry.mjs",
		"test:selection": "vitest run tests/test-selection-geometry.mjs",
		"test:symbol-distortion": "vitest run tests/test-symbol-distortion.mjs",
		"test:flight-plan": "vitest run tests/test-flight-plan-generator.mjs",
		"test:flight-plan-kml": "vitest run tests/test-flight-plan-kml.mjs",
		"test:2d": "vitest run src/lib/components/editor/2d tests/test-2d-editor-fixtures.mjs",
		"test:topo-paths": "vitest run tests/test-topo-document-paths.mjs",
		"test:topo-properties-paths": "vitest run tests/test-topo-properties-paths.mjs",
		"lint": "prettier --ignore-path .gitignore --check . && eslint --ignore-path .gitignore .",
		"format": "prettier --ignore-path .gitignore --write .",
		"data:validate": "npm run validate --prefix fels-data"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/enhanced-img": "^0.4.4",
		"@sveltejs/kit": "^2.5.27",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@tailwindcss/postcss": "^4.0.12",
		"@tailwindcss/typography": "^0.5.13",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.3",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.45.1",
		"jsdom": "^25.0.1",
		"mdsvex": "^0.11.0",
		"postcss": "^8.4.38",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.2.6",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"rehype-autolink-headings": "^6.1.1",
		"rehype-slug": "^5.1.0",
		"svelte": "^5.0.0",
		"svelte-preprocess": "^6.0.0",
		"tailwindcss": "^4.0.12",
		"vite": "^5.4.4",
		"vitest": "^2.1.9"
	},
	"type": "module",
	"dependencies": {
		"@deck.gl/core": "^9.3.7",
		"@deck.gl/layers": "^9.3.7",
		"@deck.gl/mapbox": "^9.3.7",
		"@fortawesome/fontawesome-free": "^6.5.2",
		"@tailwindcss/vite": "^4.0.12",
		"@threlte/core": "^8.0.1",
		"@threlte/extras": "^9.0.1",
		"@turf/turf": "^7.3.4",
		"@vorstieg/fels-data": "file:fels-data",
		"@vorstieg/topo-renderer": "file:topo-renderer",
		"d3-selection": "^3.0.0",
		"d3-zoom": "^3.0.0",
		"jszip": "^3.10.1",
		"maplibre-gl": "^5.24.0",
		"svelte-i18n": "^4.0.1",
		"three": "^0.175.0",
		"three-stdlib": "^2.36.1"
	}
}
