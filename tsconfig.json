{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"noImplicitAny": false,
		"resolveJsonModule": true,
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"src/**/*.d.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"tests/**/*.js",
		"tests/**/*.ts",
		"vite.config.js",
		"vitest-setup.js",
		"svelte.config.js"
	]
}
