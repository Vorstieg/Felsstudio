VITE_FELSLAGER_URL=http://localhost:3001/api/fs
# Custom OSM overlay served by Felslager; optional override.
# Defaults to /api/tiles/via-ferrata.pmtiles beside VITE_FELSLAGER_URL.
# VITE_VIA_FERRATA_TILES_URL=http://localhost:3001/api/tiles/via-ferrata.pmtiles
# BRouter endpoint for "follow ways" track routing (all hiking trails T1-T6 + via ferratas).
# Defaults to https://brouter.de/brouter; set VITE_ROUTING_PROFILE to skip uploading the inline profile.
# VITE_ROUTING_URL=http://localhost:17777/brouter
# VITE_ROUTING_PROFILE=alpine-trace
# Run Studio at http://localhost:5173 so local authentication cookies work.
# Set Felslager STUDIO_URL/TRUSTED_ORIGINS to the actual Studio origin.
# Create a browser key in MapTiler Cloud and authorize this app's origin(s).
VITE_MAPTILER_API_KEY=
